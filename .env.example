# Supabase project settings
# Copy this file to .env.local and fill the values from Supabase > Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server only. Never expose this key with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Optional. Used as the canonical origin in production.
# NEXT_PUBLIC_SITE_URL=https://maisonlilyazahra.com

# Optional. Comma-separated emails that become owner on first sign-in.
# ADMIN_EMAILS=bonjour@maisonlilyazahra.com
